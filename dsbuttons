// TFT Control Pins (Data pins D2-D9 remain wired to Uno D2-D9)
#define LCD_CS    A3 // Shared with Touch YP (must be analog)
#define LCD_CD    A2 // Shared with Touch XM (must be analog)
#define LCD_WR    A1
#define LCD_RD    A0
#define LCD_RESET 13 // Rewired from A4 to Digital Pin 13

// Touchscreen shared pins
#define YP A3
#define XM A2
#define YM 9
#define XP 8

// Touch calibration for Elegoo 2.8" TFT
#define TS_MINX 120
#define TS_MAXX 900
#define TS_MINY 70
#define TS_MAXY 920
#define MINPRESSURE 10
#define MAXPRESSURE 1000

// Landscape Touch Axis Toggles
#define INVERT_TOUCH_X true
#define INVERT_TOUCH_Y true

// 3 Momentary Push Buttons: A (Green), B (Red), X (Blue) (Wired between pin and GND)
// Note: D10, D11, and D12 are all free since the SD card slot is unused.
#define BTN_A 12  // Digital Pin D12
#define BTN_B 11  // Digital Pin D11 
#define BTN_X 10  // Digital Pin D10 (Unused SD Card CS pin)

// Slide Thumbstick (Dedicated analog inputs on A4 and A5)
#define STICK_X A4
#define STICK_Y A5

#define STICK_MIN_MOVE     90  // Minimum analog delta from center during calibration
#define STICK_RELEASE_DIST 85  // Distance from center considered back at rest

// EEPROM storage address for saved thumbstick calibration
#define EEPROM_CAL_MAGIC_ADDR 0
#define EEPROM_CAL_MAGIC_VAL  0xB7

// 16-bit RGB565 Color Definitions
#define BLACK    0x0000
#define BLUE     0x001F
#define RED      0xF800
#define GREEN    0x07E0
#define CYAN     0x07FF
#define MAGENTA  0xF81F
#define YELLOW   0xFFE0
#define WHITE    0xFFFF
#define DARKGREY 0x39E7
#define ORANGE   0xFD20
#define PURPLE   0x780F
#define TEAL     0x0410

Elegoo_TFTLCD tft(LCD_CS, LCD_CD, LCD_WR, LCD_RD, LCD_RESET);

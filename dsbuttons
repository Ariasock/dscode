  tft.drawRect(8, 26, 304, 12, WHITE);
  tft.fillRect(10, 28, 300, 8, GREEN);
}

// Draw live next-step hint in HUD if Debug Hints or God Mode is enabled
void drawDebugHint(uint8_t stepIndex) {
  if (debugCheatLevel == 0) return;

  tft.fillRect(98, 4, 64, 18, MAGENTA);
  tft.setTextColor(WHITE);
  tft.setTextSize(1);
  tft.setCursor(102, 9);

  uint8_t target = sequence[stepIndex];
  if (activeGame == GAME_STICK) {
    const char* dirNames[4] = {"NXT:UP", "NXT:DN", "NXT:LT", "NXT:RT"};
    tft.print(dirNames[target]);
  } else if (activeGame == GAME_TOUCH) {
    const char* padNames[4] = {"PAD:TL", "PAD:TR", "PAD:BL", "PAD:BR"};
    tft.print(padNames[target]);
  } else {
    tft.print(F("BTN: #"));
    tft.print(target + 1);
  }
}

void updateTimerBar(unsigned long elapsed, unsigned long limit, int &lastWidth, uint16_t &lastColor) {
  if (elapsed > limit) elapsed = limit;
  int newWidth = map(limit - elapsed, 0, limit, 0, 300);

  if (newWidth != lastWidth) {
    uint16_t barColor = GREEN;
    if (newWidth < 150) barColor = YELLOW;
    if (newWidth < 75)  barColor = RED;

    if (newWidth < lastWidth) {
      tft.fillRect(10 + newWidth, 28, lastWidth - newWidth, 8, DARKGREY);
    }

    if (barColor != lastColor && newWidth > 0) {
      tft.fillRect(10, 28, newWidth, 8, barColor);
      lastColor = barColor;
    }

    lastWidth = newWidth;
  }
}

// --- MINIGAME 1: TOUCH SCREEN (2x2 Grid in Landscape) ---
void drawTouchPad(uint8_t index, bool lit) {
  int x = (index % 2 == 0) ? 40 : 170;
  int y = (index < 2) ? 74 : 156;
  uint16_t baseColors[4] = {RED, BLUE, GREEN, YELLOW};
  uint16_t drawColor = lit ? WHITE : baseColors[index];

  tft.fillRect(x, y, 110, 70, drawColor);
  tft.drawRect(x, y, 110, 70, WHITE);
  if (lit) {
    tft.fillRect(x + 15, y + 12, 80, 46, baseColors[index]);
  }
}

void drawTouchBoard() {
  tft.fillRect(0, 45, 320, 195, BLACK);
  tft.setTextColor(WHITE);
  tft.setTextSize(2);
  tft.setCursor(70, 50);
  tft.print(F("MODE: TOUCH PAD"));
  for (uint8_t i = 0; i < 4; i++) {
    drawTouchPad(i, false);
  }
}

// --- MINIGAME 2: SLIDE THUMBSTICK (4 Directional Arrows in Landscape) ---
void drawStickArrow(uint8_t dir, bool lit) {
  uint16_t color = lit ? YELLOW : DARKGREY;

  if (dir == DIR_UP) {
    tft.fillTriangle(160, 72, 130, 116, 190, 116, color);
    tft.drawTriangle(160, 72, 130, 116, 190, 116, WHITE);
  } else if (dir == DIR_DOWN) {
    tft.fillTriangle(160, 232, 130, 188, 190, 188, color);
    tft.drawTriangle(160, 232, 130, 188, 190, 188, WHITE);
  } else if (dir == DIR_LEFT) {
    tft.fillTriangle(65, 152, 115, 124, 115, 180, color);
    tft.drawTriangle(65, 152, 115, 124, 115, 180, WHITE);
  } else if (dir == DIR_RIGHT) {
    tft.fillTriangle(255, 152, 205, 124, 205, 180, color);
    tft.drawTriangle(255, 152, 205, 124, 205, 180, WHITE);
  }
}

void drawStickBoard() {
  tft.fillRect(0, 45, 320, 195, BLACK);
  tft.setTextColor(CYAN);
  tft.setTextSize(2);
  tft.setCursor(64, 50);
  tft.print(F("MODE: THUMBSTICK"));
  tft.fillCircle(160, 152, 14, DARKGREY);
  for (uint8_t i = 0; i < 4; i++) {
    drawStickArrow(i, false);
  }
}

// --- MINIGAME 3: 3 PUSH BUTTONS (in Landscape) ---
void drawButtonIcon(uint8_t index, bool lit) {
  int x = 65 + (index * 95);
  int y = 152;
  uint16_t baseColors[3] = {MAGENTA, CYAN, ORANGE};
  uint16_t color = lit ? WHITE : baseColors[index];

  tft.fillCircle(x, y, 34, color);

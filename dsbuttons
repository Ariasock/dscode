void runDebugMenu() {
  drawDebugMenuScreen();
  waitForRelease();

  int lastCrossX = -1;
  int lastCrossY = -1;

  while (true) {
    int px = 0, py = 0, rawX = 0, rawY = 0;
    bool touched = getLandscapeTouchRaw(px, py, rawX, rawY);

    if (touched) {
      if (lastCrossX != -1) {
        tft.fillCircle(lastCrossX, lastCrossY, 3, BLACK);
      }
      tft.fillCircle(px, py, 3, YELLOW);
      lastCrossX = px;
      lastCrossY = py;

      // Row 1 Buttons (y: 28..68)
      if (py >= 28 && py <= 68) {
        if (px >= 10 && px <= 155) {
          debugStartStage++;
          if (debugStartStage > 6) debugStartStage = 1;
          drawDebugMenuScreen();
          waitForRelease();
        } else if (px >= 165 && px <= 310) {
          debugForceMode++;
          if (debugForceMode > 2) debugForceMode = -1;
          drawDebugMenuScreen();
          waitForRelease();
        }
      }
      // Row 2 Buttons (y: 74..114)
      else if (py >= 74 && py <= 114) {
        if (px >= 10 && px <= 155) {
          debugCheatLevel = (debugCheatLevel + 1) % 3;
          drawDebugMenuScreen();
          waitForRelease();
        } else if (px >= 165 && px <= 310) {
          waitForRelease();
          runStickCalibrationWizard();
          drawDebugMenuScreen();
          waitForRelease();
        }
      }
      // Row 3 Start Button (y: 120..154)
      else if (py >= 120 && py <= 154 && px >= 10 && px <= 310) {
        waitForRelease();
        break; // Exit Debug Menu & Start Game
      }
    }

    // Update Live Hardware Readout inside bottom box
    int sx = readStickAnalog(STICK_X);
    int sy = readStickAnalog(STICK_Y);
    int8_t sDir = readStickDirection(touched, px, py);

    bool bA = isButtonPressed(BTN_A);

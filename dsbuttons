}

// ==========================================
// 5. SEQUENCE PLAYBACK & INPUT READING
// ==========================================

void playSequence() {
  currentSeqLen = currentStage + 2 + stage5Loops;
  if (currentSeqLen > MAX_SEQ_LEN) currentSeqLen = MAX_SEQ_LEN;

  uint8_t numOptions = 4;
  if (activeGame == GAME_BUTTONS) {
    numOptions = 3;
  } else if (activeGame == GAME_TOUCH) {
    numOptions = getTouchPadCount();
  }

  for (uint8_t i = 0; i < currentSeqLen; i++) {
    sequence[i] = random(0, numOptions);
  }

  int onTime = max(140, 500 - (currentStage * 60) - (stage5Loops * 25));
  int offTime = max(70, 210 - (currentStage * 25) - (stage5Loops * 10));

  delay(600);
  for (uint8_t i = 0; i < currentSeqLen; i++) {
    highlightStep(sequence[i], true);
    delay(onTime);
    highlightStep(sequence[i], false);
    delay(offTime);
  }
}

// Evaluates thumbstick direction using the calibrated target vectors for UP, DOWN, LEFT, RIGHT
int8_t readStickDirection(bool touched, int px, int py) {
  if (stickConnected) {
    int sx = readStickAnalog(STICK_X);
    int sy = readStickAnalog(STICK_Y);
    long dx = sx - stickCenterX;
    long dy = sy - stickCenterY;

    if (abs(dx) > STICK_RELEASE_DIST || abs(dy) > STICK_RELEASE_DIST) {
      int8_t bestDir = -1;
      long bestScore = 55; // Must reach at least 55% of calibrated throw in that direction

      for (uint8_t d = 0; d < 4; d++) {
        long vx = calTargetX[d] - stickCenterX;
        long vy = calTargetY[d] - stickCenterY;
        long magSq = (vx * vx) + (vy * vy);
        if (magSq < 2500) continue;

        long dot = (dx * vx) + (dy * vy);
        if (dot > 0) {
          long pct = (dot * 100L) / magSq;
          if (pct > bestScore) {
            bestScore = pct;
            bestDir = d;
          }
        }
      }

      if (bestDir != -1) {
        return bestDir;
      }
    }
  }

  // Touchscreen fallback (with Right and Down matched to your panel)
  if (touched) {
    if (px >= 120 && px <= 200 && py >= 68 && py <= 122)  return DIR_UP;
    if (px >= 120 && px <= 200 && py >= 182 && py <= 236) return DIR_RIGHT;
    if (px >= 55 && px <= 122 && py >= 118 && py <= 186)  return DIR_LEFT;
    if (px >= 198 && px <= 265 && py >= 118 && py <= 186) return DIR_DOWN;
  }

  return -1;
}

int8_t pollActiveInput() {
  int px, py;
  bool touched = getLandscapeTouch(px, py);

  if (activeGame == GAME_TOUCH) {
    if (touched) {
      uint8_t padCount = getTouchPadCount();
      for (uint8_t i = 0; i < padCount; i++) {
        int bx, by, bw, bh;
        getTouchPadBounds(i, bx, by, bw, bh);
        // Check touch within pad bounds (with a small 3px tolerance margin)
        if (px >= (bx - 3) && px <= (bx + bw + 3) &&
            py >= (by - 3) && py <= (by + bh + 3)) {
          return i;
        }
      }
    }
  } 
  else if (activeGame == GAME_STICK) {
    return readStickDirection(touched, px, py);
  } 
  else if (activeGame == GAME_BUTTONS) {
    // 1. Check physical buttons: A (D12), B (D11), X (D10)
    if (isButtonPressed(BTN_A)) return 0; // A (Green)
    if (isButtonPressed(BTN_B)) return 1; // B (Red)
    if (isButtonPressed(BTN_X)) return 2; // X (Blue)

    // 2. Touchscreen fallback on A, B, X circles
    if (touched && py >= 112 && py <= 192) {
      if (px >= 25 && px <= 105)  return 0; // Button A
      if (px >= 120 && px <= 200) return 1; // Button B
      if (px >= 215 && px <= 295) return 2; // Button X
    }
  }

  return -1;
}


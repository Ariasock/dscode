#include <Elegoo_GFX.h>    // Core graphics library
#include <Elegoo_TFTLCD.h> // Hardware-specific library
#include <TouchScreen.h>   // Touch library

// ==========================================
// 1. PIN DEFINITIONS & ORIENTATION SETTINGS
// ==========================================

// TFT Control Pins (Data pins D2-D9 remain wired to Uno D2-D9)
#define LCD_CS    A3 // Shared with Touch YP (must be analog)
#define LCD_CD    A2 // Shared with Touch XM (must be analog)
#define LCD_WR    A1
#define LCD_RD    A0
#define LCD_RESET 13 // Rewired from A4 to Digital Pin 13

// Touchscreen shared pins
#define YP A3
#define XM A2
#define YM 9
#define XP 8

// Touch calibration for Elegoo 2.8" TFT
#define TS_MINX 120
#define TS_MAXX 900
#define TS_MINY 70
#define TS_MAXY 920
#define MINPRESSURE 10
#define MAXPRESSURE 1000

// Landscape Touch Axis Toggles:
// Based on your test (Top-Right registering as Bottom-Right in portrait),
// these are set for Landscape (setRotation(1)). If an axis feels mirrored
// depending on which way you hold the landscape screen, flip true/false here:
#define INVERT_TOUCH_X true
#define INVERT_TOUCH_Y true

// 3 Momentary Push Buttons (Wired between pin and GND)
#define BTN_1 10
#define BTN_2 11
#define BTN_3 12

// Slide Thumbstick (Analog inputs on A4 and A5)
#define STICK_X A4
#define STICK_Y A5

#define STICK_TRIGGER_DIST 180 // Distance from center needed to register a slide
#define STICK_RELEASE_DIST 110 // Distance from center considered back at rest

// 16-bit RGB565 Color Definitions
#define BLACK    0x0000
#define BLUE     0x001F
#define RED      0xF800
#define GREEN    0x07E0
#define CYAN     0x07FF
#define MAGENTA  0xF81F
#define YELLOW   0xFFE0
#define WHITE    0xFFFF
#define DARKGREY 0x39E7
#define ORANGE   0xFD20

Elegoo_TFTLCD tft(LCD_CS, LCD_CD, LCD_WR, LCD_RD, LCD_RESET);
TouchScreen ts = TouchScreen(XP, YP, XM, YM, 300);

// ==========================================
// 2. GAME CONSTANTS & STATE VARIABLES
// ==========================================
#define GAME_TOUCH   0
#define GAME_STICK   1
#define GAME_BUTTONS 2

#define DIR_UP    0
#define DIR_DOWN  1
#define DIR_LEFT  2
#define DIR_RIGHT 3

#define MAX_SEQ_LEN 14
uint8_t sequence[MAX_SEQ_LEN];
uint8_t currentSeqLen = 3;

uint8_t currentStage = 1;          // Stages 1 to 5
uint8_t levelInStage = 0;          // Current level index within the 5-level stage (0 to 4)
uint8_t winsInStage = 0;           // Need 3 wins out of the 5 levels to advance
uint8_t failsInStage = 0;          // 3 fails in one stage = Game Over
uint8_t totalErrors = 0;           // Must be 0 to unlock Stage 5 endless overtime loop
uint8_t stage5Loops = 0;           // Count of Stage 5 clears
bool isFirstBoot = true;           // Seeds RNG on first start press

uint8_t stagePool[5];              // Holds the 5 randomized minigame types for the stage
unsigned long timeLimitMs = 20000; // Default 20.0s (20000 ms), cuts 2.5s per Stage 5 win
uint8_t activeGame = GAME_TOUCH;

// Thumbstick calibration & auto-detection state
bool stickConnected = false;
int stickCenterX = 512;
int stickCenterY = 512;

// ==========================================
// 3. HARDWARE & TOUCH HELPERS
// ==========================================

// Restore shared A2/A3 pins back to OUTPUT and HIGH after reading TouchScreen
void restoreTFTPins() {
  pinMode(XM, OUTPUT);
  pinMode(YP, OUTPUT);
  digitalWrite(XM, HIGH);
  digitalWrite(YP, HIGH);
}

// Read clean analog value (discards first sample to prevent ADC mux ghosting from A2/A3)
int readCleanAnalog(uint8_t pin) {
  analogRead(pin);
  return analogRead(pin);
}

// Auto-detect if the slide thumbstick is wired up, and calibrate its resting center
void calibrateThumbstick() {
  // Briefly enable internal pull-ups on A4/A5.
  // If nothing is wired up, both floating pins immediately pull up near 1023.
  // If a 10k slide pot is wired up, it holds the pins near center (~512-560).
  pinMode(STICK_X, INPUT_PULLUP);
  pinMode(STICK_Y, INPUT_PULLUP);
  delay(5);
  int testX = readCleanAnalog(STICK_X);
  int testY = readCleanAnalog(STICK_Y);

  pinMode(STICK_X, INPUT);
  pinMode(STICK_Y, INPUT);
  delay(5);

  if (testX > 960 && testY > 960) {
    stickConnected = false; // Pins are floating (unplugged)
    return;
  }

  stickConnected = true;
  long sumX = 0;
  long sumY = 0;
  for (uint8_t i = 0; i < 16; i++) {
    sumX += readCleanAnalog(STICK_X);
    sumY += readCleanAnalog(STICK_Y);
    delay(3);
  }
  stickCenterX = sumX / 16;
  stickCenterY = sumY / 16;

  if (stickCenterX < 300 || stickCenterX > 720) stickCenterX = 512;
  if (stickCenterY < 300 || stickCenterY > 720) stickCenterY = 512;
}

// Read touch screen and map coordinates to Landscape (320x240)
bool getLandscapeTouch(int &px, int &py) {
  TSPoint p = ts.getPoint();
  restoreTFTPins();

  if (p.z > MINPRESSURE && p.z < MAXPRESSURE) {
    // In Landscape (setRotation(1)), touch p.y maps to Screen X (0..320)
    // and touch p.x maps to Screen Y (0..240)
    if (INVERT_TOUCH_X) {
      px = map(p.y, TS_MAXY, TS_MINY, 0, 320);
    } else {
      px = map(p.y, TS_MINY, TS_MAXY, 0, 320);
    }

    if (INVERT_TOUCH_Y) {
      py = map(p.x, TS_MAXX, TS_MINX, 0, 240);
    } else {
      py = map(p.x, TS_MINX, TS_MAXX, 0, 240);
    }

    px = constrain(px, 0, 319);
    py = constrain(py, 0, 239);
    return true;
  }
  return false;
}

// Check if any active input is currently held down
bool isAnyInputHeld() {
  if (digitalRead(BTN_1) == LOW || digitalRead(BTN_2) == LOW || digitalRead(BTN_3) == LOW) {
    return true;
  }

  if (stickConnected) {
    int dx = abs(readCleanAnalog(STICK_X) - stickCenterX);
    int dy = abs(readCleanAnalog(STICK_Y) - stickCenterY);
    if (dx > STICK_RELEASE_DIST || dy > STICK_RELEASE_DIST) {
      return true;
    }
  }

  int px, py;
  if (getLandscapeTouch(px, py)) {
    return true;
  }

  return false;
}

// Wait until buttons are unpressed, thumbstick is centered, and screen is untouched
void waitForRelease() {
  while (isAnyInputHeld()) {
    delay(15);
  }
}

// Populate and shuffle the 5 levels for the current stage
void generateStagePool() {
  stagePool[0] = GAME_TOUCH;
  stagePool[1] = GAME_STICK;
  stagePool[2] = GAME_BUTTONS;
  stagePool[3] = random(0, 3);
  stagePool[4] = random(0, 3);

  for (uint8_t i = 4; i > 0; i--) {
    uint8_t j = random(0, i + 1);
    uint8_t temp = stagePool[i];
    stagePool[i] = stagePool[j];
    stagePool[j] = temp;
  }
}

// ==========================================
// 4. LANDSCAPE GRAPHICS & MINIGAME BOARDS (320x240)
// ==========================================

void drawHUD() {
  tft.fillRect(0, 0, 320, 44, DARKGREY);
  tft.setTextColor(WHITE);
  tft.setTextSize(2);
  tft.setCursor(8, 6);
  tft.print("STG:");
  tft.print(currentStage);

  if (stage5Loops > 0) {
    tft.setTextColor(YELLOW);
    tft.print("+");
    tft.print(stage5Loops);
  }

  // Wins (W:x/3) and Level (L:x/5) fit cleanly on the 320px wide top bar
  tft.setTextColor(CYAN);
  tft.setCursor(165, 6);
  tft.print("W:");
  tft.print(winsInStage);
  tft.print("/3 L:");
  tft.print(levelInStage + 1);
  tft.print("/5");

  // Landscape Timer bar frame (300px inner width)
  tft.drawRect(8, 26, 304, 12, WHITE);
  tft.fillRect(10, 28, 300, 8, GREEN);
}

void updateTimerBar(unsigned long elapsed, unsigned long limit, int &lastWidth, uint16_t &lastColor) {
  if (elapsed > limit) elapsed = limit;
  int newWidth = map(limit - elapsed, 0, limit, 0, 300);

  if (newWidth != lastWidth) {
    uint16_t barColor = GREEN;
    if (newWidth < 150) barColor = YELLOW;
    if (newWidth < 75)  barColor = RED;

    if (newWidth < lastWidth) {
      tft.fillRect(10 + newWidth, 28, lastWidth - newWidth, 8, DARKGREY);
    }

    if (barColor != lastColor && newWidth > 0) {
      tft.fillRect(10, 28, newWidth, 8, barColor);
      lastColor = barColor;
    }

    lastWidth = newWidth;
  }
}

// --- MINIGAME 1: TOUCH SCREEN (2x2 Grid in Landscape) ---
// Pads are 110x70: Left col x=40, Right col x=170 | Top row y=74, Bottom row y=156
void drawTouchPad(uint8_t index, bool lit) {
  int x = (index % 2 == 0) ? 40 : 170;
  int y = (index < 2) ? 74 : 156;
  uint16_t baseColors[4] = {RED, BLUE, GREEN, YELLOW};
  uint16_t drawColor = lit ? WHITE : baseColors[index];

  tft.fillRect(x, y, 110, 70, drawColor);
  tft.drawRect(x, y, 110, 70, WHITE);
  if (lit) {
    tft.fillRect(x + 15, y + 12, 80, 46, baseColors[index]);
  }
}

void drawTouchBoard() {
  tft.fillRect(0, 45, 320, 195, BLACK);
  tft.setTextColor(WHITE);
  tft.setTextSize(2);
  tft.setCursor(70, 50);
  tft.print("MODE: TOUCH PAD");
  for (uint8_t i = 0; i < 4; i++) {
    drawTouchPad(i, false);
  }
}

// --- MINIGAME 2: SLIDE THUMBSTICK (4 Directional Arrows in Landscape) ---
// Centered around (160, 152)
void drawStickArrow(uint8_t dir, bool lit) {
  uint16_t color = lit ? YELLOW : DARKGREY;

  if (dir == DIR_UP) {
    tft.fillTriangle(160, 72, 130, 116, 190, 116, color);
    tft.drawTriangle(160, 72, 130, 116, 190, 116, WHITE);
  } else if (dir == DIR_DOWN) {
    tft.fillTriangle(160, 232, 130, 188, 190, 188, color);
    tft.drawTriangle(160, 232, 130, 188, 190, 188, WHITE);
  } else if (dir == DIR_LEFT) {
    tft.fillTriangle(65, 152, 115, 124, 115, 180, color);
    tft.drawTriangle(65, 152, 115, 124, 115, 180, WHITE);
  } else if (dir == DIR_RIGHT) {
    tft.fillTriangle(255, 152, 205, 124, 205, 180, color);
    tft.drawTriangle(255, 152, 205, 124, 205, 180, WHITE);
  }
}

void drawStickBoard() {
  tft.fillRect(0, 45, 320, 195, BLACK);
  tft.setTextColor(CYAN);
  tft.setTextSize(2);
  tft.setCursor(64, 50);
  tft.print("MODE: THUMBSTICK");
  tft.fillCircle(160, 152, 14, DARKGREY);
  for (uint8_t i = 0; i < 4; i++) {
    drawStickArrow(i, false);
  }
}

// --- MINIGAME 3: 3 PUSH BUTTONS (in Landscape) ---
// Centered at x = 65, 160, 255, y = 152
void drawButtonIcon(uint8_t index, bool lit) {
  int x = 65 + (index * 95);
  int y = 152;
  uint16_t baseColors[3] = {MAGENTA, CYAN, ORANGE};
  uint16_t color = lit ? WHITE : baseColors[index];

  tft.fillCircle(x, y, 34, color);
  tft.drawCircle(x, y, 34, WHITE);

  tft.setTextColor(BLACK);
  tft.setTextSize(2);
  tft.setCursor(x - 6, y - 7);
  tft.print(index + 1);
}

void drawButtonBoard() {
  tft.fillRect(0, 45, 320, 195, BLACK);
  tft.setTextColor(ORANGE);
  tft.setTextSize(2);
  tft.setCursor(70, 50);
  tft.print("MODE: 3 BUTTONS");
  for (uint8_t i = 0; i < 3; i++) {
    drawButtonIcon(i, false);
  }
}

void highlightStep(uint8_t val, bool lit) {
  if (activeGame == GAME_TOUCH)   drawTouchPad(val, lit);
  if (activeGame == GAME_STICK)   drawStickArrow(val, lit);
  if (activeGame == GAME_BUTTONS) drawButtonIcon(val, lit);
}

// ==========================================
// 5. SEQUENCE PLAYBACK & INPUT READING
// ==========================================

void playSequence() {
  currentSeqLen = currentStage + 2 + stage5Loops;
  if (currentSeqLen > MAX_SEQ_LEN) currentSeqLen = MAX_SEQ_LEN;

  uint8_t numOptions = (activeGame == GAME_BUTTONS) ? 3 : 4;
  for (uint8_t i = 0; i < currentSeqLen; i++) {
    sequence[i] = random(0, numOptions);
  }

  int onTime = max(140, 500 - (currentStage * 60) - (stage5Loops * 25));
  int offTime = max(70, 210 - (currentStage * 25) - (stage5Loops * 10));

  delay(600);
  for (uint8_t i = 0; i < currentSeqLen; i++) {
    highlightStep(sequence[i], true);
    delay(onTime);
    highlightStep(sequence[i], false);
    delay(offTime);
  }
}

int8_t pollActiveInput() {
  int px, py;
  bool touched = getLandscapeTouch(px, py);

  if (activeGame == GAME_TOUCH) {
    if (touched) {
      if (py >= 68 && py <= 148) {
        if (px >= 34 && px <= 156)  return 0; // Top-Left (Red)
        if (px >= 164 && px <= 286) return 1; // Top-Right (Blue)
      } else if (py >= 150 && py <= 232) {
        if (px >= 34 && px <= 156)  return 2; // Bottom-Left (Green)
        if (px >= 164 && px <= 286) return 3; // Bottom-Right (Yellow)
      }
    }
  } 
  else if (activeGame == GAME_STICK) {
    // 1. Check physical slide thumbstick if it is wired up
    if (stickConnected) {
      int sx = readCleanAnalog(STICK_X);
      int sy = readCleanAnalog(STICK_Y);
      int dx = sx - stickCenterX;
      int dy = sy - stickCenterY;

      if (abs(dy) >= abs(dx)) {
        if (dy >  STICK_TRIGGER_DIST) return DIR_UP;
        if (dy < -STICK_TRIGGER_DIST) return DIR_DOWN;
      } else {
        if (dx < -STICK_TRIGGER_DIST) return DIR_LEFT;
        if (dx >  STICK_TRIGGER_DIST) return DIR_RIGHT;
      }
    }

    // 2. Touchscreen fallback so you can test thumbstick rounds without the stick wired
    if (touched) {
      if (px >= 120 && px <= 200 && py >= 68 && py <= 122)  return DIR_UP;
      if (px >= 120 && px <= 200 && py >= 182 && py <= 236) return DIR_DOWN;
      if (px >= 55 && px <= 122 && py >= 118 && py <= 186)  return DIR_LEFT;
      if (px >= 198 && px <= 265 && py >= 118 && py <= 186) return DIR_RIGHT;
    }
  } 
  else if (activeGame == GAME_BUTTONS) {
    // 1. Check physical push buttons
    if (digitalRead(BTN_1) == LOW) return 0;
    if (digitalRead(BTN_2) == LOW) return 1;
    if (digitalRead(BTN_3) == LOW) return 2;

    // 2. Touchscreen fallback so you can test button rounds without buttons wired
    if (touched && py >= 112 && py <= 192) {
      if (px >= 25 && px <= 105)  return 0; // Button 1
      if (px >= 120 && px <= 200) return 1; // Button 2
      if (px >= 215 && px <= 295) return 2; // Button 3
    }
  }

  return -1;
}

// ==========================================
// 6. ROUND & STAGE MANAGEMENT
// ==========================================

bool runMinigameRound() {
  activeGame = stagePool[levelInStage];

  drawHUD();
  if (activeGame == GAME_TOUCH)   drawTouchBoard();
  if (activeGame == GAME_STICK)   drawStickBoard();
  if (activeGame == GAME_BUTTONS) drawButtonBoard();

  playSequence();
  waitForRelease();

  unsigned long startTime = millis();
  int lastBarWidth = 300;
  uint16_t lastBarColor = GREEN;
  uint8_t stepIndex = 0;

  while (stepIndex < currentSeqLen) {
    unsigned long elapsed = millis() - startTime;
    if (elapsed >= timeLimitMs) {
      return false; // Timed out
    }

    updateTimerBar(elapsed, timeLimitMs, lastBarWidth, lastBarColor);

    int8_t userChoice = pollActiveInput();
    if (userChoice != -1) {
      unsigned long flashStart = millis();
      highlightStep(userChoice, true);
      delay(140);
      highlightStep(userChoice, false);
      startTime += (millis() - flashStart);

      if (userChoice != sequence[stepIndex]) {
        waitForRelease();
        return false;
      }

      stepIndex++;

      if (stepIndex < currentSeqLen) {
        while (isAnyInputHeld()) {
          unsigned long heldElapsed = millis() - startTime;
          if (heldElapsed >= timeLimitMs) {
            return false;
          }
          updateTimerBar(heldElapsed, timeLimitMs, lastBarWidth, lastBarColor);
          delay(10);
        }
      } else {
        waitForRelease();
      }
    }
  }

  return true;
}

void showBanner(const char* line1, const char* line2, uint16_t bgColor) {
  tft.fillScreen(bgColor);
  tft.setTextColor(WHITE);
  tft.setTextSize(3);
  tft.setCursor(40, 85);
  tft.println(line1);
  tft.setTextSize(2);
  tft.setCursor(40, 135);
  tft.println(line2);
  delay(1400);
}

void resetGame() {
  currentStage = 1;
  levelInStage = 0;
  winsInStage = 0;
  failsInStage = 0;
  totalErrors = 0;
  stage5Loops = 0;
  timeLimitMs = 20000;
  generateStagePool();
}

void waitToStartOrRestart() {
  tft.setTextColor(YELLOW);
  tft.setTextSize(2);
  tft.setCursor(45, 200);
  tft.println("Press Btn 1 or Tap");

  while (true) {
    if (digitalRead(BTN_1) == LOW) break;
    int px, py;
    if (getLandscapeTouch(px, py)) break;
    delay(20);
  }

  if (isFirstBoot) {
    randomSeed(micros());
    isFirstBoot = false;
  }

  waitForRelease();
  resetGame();
}

// ==========================================
// 7. SETUP & LOOP
// ==========================================

void setup() {
  Serial.begin(9600);

  pinMode(BTN_1, INPUT_PULLUP);
  pinMode(BTN_2, INPUT_PULLUP);
  pinMode(BTN_3, INPUT_PULLUP);

  // Detect if thumbstick is wired up and calibrate center
  calibrateThumbstick();

  tft.reset();
  uint16_t identifier = tft.readID();
  if (identifier == 0x9325 || identifier == 0x9328 || identifier == 0x4535 || 
      identifier == 0x7575 || identifier == 0x9341 || identifier == 0x8357) {
    tft.begin(identifier);
  } else {
    tft.begin(0x9341);
  }

  tft.setRotation(1); // Landscape mode (320x240)
  tft.setTextWrap(false);

  // Landscape Title Screen
  tft.fillScreen(BLUE);
  tft.drawRect(6, 6, 308, 228, WHITE);
  tft.setTextColor(WHITE);
  tft.setTextSize(3);
  tft.setCursor(52, 55);
  tft.println("MEMORY BLITZ");

  tft.setTextSize(2);
  tft.setCursor(45, 110);
  tft.println("Pass 3 of 5 Levels");

  // Shows hardware detection status right on the title screen
  tft.setTextSize(1);
  tft.setTextColor(CYAN);
  tft.setCursor(65, 155);
  if (stickConnected) {
    tft.println("Thumbstick: DETECTED (A4/A5)");
  } else {
    tft.println("Thumbstick: UNPLUGGED (Touch Mode)");
  }

  waitToStartOrRestart();
}

void loop() {
  bool passed = runMinigameRound();
  levelInStage++;

  if (passed) {
    winsInStage++;
    showBanner("LEVEL CLEAR!", "Nice job!", GREEN);
  } else {
    failsInStage++;
    totalErrors++;
    showBanner("MISS!", "Sequence Failed", RED);
  }

  if (failsInStage >= 3 || (stage5Loops > 0 && !passed)) {
    tft.fillScreen(RED);
    tft.setTextColor(WHITE);
    tft.setTextSize(3);
    tft.setCursor(70, 55);
    tft.println("GAME OVER!");
    tft.setTextSize(2);
    tft.setCursor(55, 110);
    tft.print("Stage Reached: ");
    tft.println(currentStage);
    tft.setCursor(55, 140);
    tft.print("Stage 5 Loops: ");
    tft.println(stage5Loops);
    waitToStartOrRestart();
    return;
  }

  if (winsInStage >= 3) {
    levelInStage = 0;
    winsInStage = 0;
    failsInStage = 0;
    generateStagePool();

    if (currentStage < 5) {
      currentStage++;
      showBanner("STAGE UP!", "Speed Increased!", BLUE);
    } else {
      if (totalErrors == 0) {
        stage5Loops++;
        if (timeLimitMs > 2500) {
          timeLimitMs -= 2500;
        }
        tft.fillScreen(MAGENTA);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(52, 55);
        tft.println("FLAWLESS S5!");
        tft.setTextSize(2);
        tft.setCursor(55, 110);
        tft.println("Repeating Stage 5");
        tft.setCursor(55, 140);
        tft.print("New Timer: ");
        tft.print(timeLimitMs / 1000.0, 1);
        tft.println("s");
        delay(2200);
      } else {
        tft.fillScreen(BLUE);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(85, 55);
        tft.println("YOU WIN!");
        tft.setTextSize(2);
        tft.setCursor(55, 110);
        tft.println("Stage 5 Complete!");
        tft.setCursor(55, 140);
        tft.println("Go Flawless for OT");
        waitToStartOrRestart();
      }
    }
  }
}

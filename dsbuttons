void runDebugMenu() {
  tft.fillScreen(BLACK);
  tft.fillRect(0, 0, 320, 26, MAGENTA);
  tft.setTextColor(WHITE);
  tft.setTextSize(2);
  tft.setCursor(45, 5);
  tft.print(F("SECRET DEBUG MODE"));

  drawDebugButtons();

  // Live Hardware Inspector Box
  tft.drawRect(10, 144, 300, 90, WHITE);
  tft.setTextSize(1);
  tft.setTextColor(YELLOW);
  tft.setCursor(18, 150);
  tft.print(F("LIVE INPUT MONITOR (Touch anywhere to test):"));

  waitForRelease();

  int lastCrossX = -1;
  int lastCrossY = -1;

  while (true) {
    int px = 0, py = 0, rawX = 0, rawY = 0;
    bool touched = getLandscapeTouchRaw(px, py, rawX, rawY);

    // Physical Button Shortcuts inside Debug Menu
    if (digitalRead(BTN_1) == LOW) {
      waitForRelease();
      break; // Start Game
    }
    if (digitalRead(BTN_2) == LOW) {
      debugForceMode++;
      if (debugForceMode > 2) debugForceMode = -1;
      drawDebugButtons();
      waitForRelease();
    }
    if (digitalRead(BTN_3) == LOW) {
      debugCheatLevel = (debugCheatLevel + 1) % 3;
      drawDebugButtons();
      waitForRelease();
    }

    // Check Touch Buttons
    if (touched) {
      // Draw a live yellow crosshair dot where the touch registered
      if (lastCrossX != -1) {
        tft.fillCircle(lastCrossX, lastCrossY, 3, BLACK);
      }
      tft.fillCircle(px, py, 3, YELLOW);
      lastCrossX = px;
      lastCrossY = py;

      if (py >= 32 && py <= 80) {
        if (px >= 10 && px <= 155) {
          debugStartStage++;
          if (debugStartStage > 6) debugStartStage = 1;
          drawDebugButtons();
          waitForRelease();
        } else if (px >= 165 && px <= 310) {
          debugForceMode++;
          if (debugForceMode > 2) debugForceMode = -1;
          drawDebugButtons();
          waitForRelease();
        }
      } else if (py >= 88 && py <= 136) {
        if (px >= 10 && px <= 155) {
          debugCheatLevel = (debugCheatLevel + 1) % 3;
          drawDebugButtons();
          waitForRelease();
        } else if (px >= 165 && px <= 310) {
          waitForRelease();
          break; // Exit Debug Menu & Start Game
        }
      }
    }

    // Update Live Hardware Readout every frame
    int sx = readCleanAnalog(STICK_X);
    int sy = readCleanAnalog(STICK_Y);
    int8_t sDir = readStickDirection(touched, px, py);

    tft.fillRect(16, 164, 288, 64, BLACK);
    tft.setTextSize(1);

    // Line 1: Thumbstick values & direction
    tft.setTextColor(CYAN);
    tft.setCursor(18, 166);
    tft.print(F("STICK A4(X):"));
    tft.print(sx);
    tft.print(F(" A5(Y):"));
    tft.print(sy);
    tft.print(F(" Dir:"));
    if (sDir == DIR_UP)         tft.print(F("UP"));
    else if (sDir == DIR_DOWN)  tft.print(F("DOWN"));
    else if (sDir == DIR_LEFT)  tft.print(F("LEFT"));
    else if (sDir == DIR_RIGHT) tft.print(F("RIGHT"));
    else                        tft.print(F("IDLE"));

    // Line 2: Touch Screen raw & mapped coordinates
    tft.setTextColor(GREEN);
    tft.setCursor(18, 184);
    tft.print(F("TOUCH px:"));
    tft.print(px);
    tft.print(F(" py:"));
    tft.print(py);
    tft.print(F(" (Raw "));
    tft.print(rawX);
    tft.print(F(","));
    tft.print(rawY);
    tft.print(F(")"));

    // Line 3: Digital Push Buttons
    tft.setTextColor(ORANGE);
    tft.setCursor(18, 202);
    tft.print(F("BTNS  D10:"));
    tft.print(digitalRead(BTN_1) == LOW ? F("ON ") : F("OFF"));
    tft.print(F(" D11:"));
    tft.print(digitalRead(BTN_2) == LOW ? F("ON ") : F("OFF"));
    tft.print(F(" D12:"));
    tft.print(digitalRead(BTN_3) == LOW ? F("ON") : F("OFF"));

    delay(40);
  }
}

// ==========================================
// 7. ROUND & STAGE MANAGEMENT
// ==========================================

bool runMinigameRound() {
  activeGame = stagePool[levelInStage];

  drawHUD();
  if (activeGame == GAME_TOUCH)   drawTouchBoard();
  if (activeGame == GAME_STICK)   drawStickBoard();
  if (activeGame == GAME_BUTTONS) drawButtonBoard();

  playSequence();
  waitForRelease();

  unsigned long startTime = millis();
  int lastBarWidth = 300;
  uint16_t lastBarColor = GREEN;
  uint8_t stepIndex = 0;

  drawDebugHint(stepIndex);

  while (stepIndex < currentSeqLen) {
    unsigned long elapsed = millis() - startTime;
    if (elapsed >= timeLimitMs) {
      if (debugCheatLevel == 2) return true; // God mode never fails on timeout
      return false; // Timed out
    }

    updateTimerBar(elapsed, timeLimitMs, lastBarWidth, lastBarColor);

    int8_t userChoice = pollActiveInput();
    if (userChoice != -1) {
      unsigned long flashStart = millis();
      highlightStep(userChoice, true);
      delay(140);
      highlightStep(userChoice, false);
      startTime += (millis() - flashStart);

      if (userChoice != sequence[stepIndex] && debugCheatLevel < 2) {
        waitForRelease();
        return false;
      }

      stepIndex++;
      if (stepIndex < currentSeqLen) {
        drawDebugHint(stepIndex);
        while (isAnyInputHeld()) {
          unsigned long heldElapsed = millis() - startTime;
          if (heldElapsed >= timeLimitMs) {
            if (debugCheatLevel == 2) return true;
            return false;
          }
          updateTimerBar(heldElapsed, timeLimitMs, lastBarWidth, lastBarColor);
          delay(10);
        }
      } else {
        waitForRelease();
      }
    }
  }

  return true;
}

void showBanner(const char* line1, const char* line2, uint16_t bgColor) {
  tft.fillScreen(bgColor);
  tft.setTextColor(WHITE);
  tft.setTextSize(3);
  tft.setCursor(40, 85);
  tft.println(line1);
  tft.setTextSize(2);
  tft.setCursor(40, 135);
  tft.println(line2);
  delay(1400);
}

void resetGame() {
  if (debugStartStage <= 5) {
    currentStage = debugStartStage;
    stage5Loops = 0;
    timeLimitMs = 20000;
  } else {
    currentStage = 5;
    stage5Loops = 1;
    timeLimitMs = 17500;
  }
  levelInStage = 0;
  winsInStage = 0;
  failsInStage = 0;
  totalErrors = 0;
  generateStagePool();
}

void waitToStartOrRestart() {
  tft.setTextColor(YELLOW);
  tft.setTextSize(2);
  tft.setCursor(45, 192);
  tft.println(F("Press Btn 1 or Tap"));

  tft.setTextColor(WHITE);
  tft.setTextSize(1);
  tft.setCursor(52, 218);
  tft.println(F("(Hold Touch 1.2s for Debug Menu)"));

  bool openDebug = false;

  while (true) {
    if (digitalRead(BTN_1) == LOW) break;

    // Pressing Button 2 or Button 3 opens Secret Debug Mode immediately
    if (digitalRead(BTN_2) == LOW || digitalRead(BTN_3) == LOW) {
      openDebug = true;
      break;
    }

    int px, py;
    if (getLandscapeTouch(px, py)) {
      unsigned long holdStart = millis();
      // Measure how long the player holds their finger on the screen
      while (getLandscapeTouch(px, py)) {
        unsigned long heldMs = millis() - holdStart;
        int barW = map(constrain(heldMs, 0, 1200), 0, 1200, 0, 200);
        tft.fillRect(60, 228, barW, 4, MAGENTA);

        if (heldMs >= 1200) {
          openDebug = true;
          break;
        }
        delay(20);
      }
      break; // Quick tap starts game; 1.2s hold opens Debug Menu
    }
    delay(20);
  }

  if (isFirstBoot) {
    randomSeed(micros());
    isFirstBoot = false;
  }

  waitForRelease();
  if (openDebug) {
    runDebugMenu();
  }
  resetGame();
}

// ==========================================
// 8. SETUP & LOOP
// ==========================================

void setup() {
  Serial.begin(9600);

  pinMode(BTN_1, INPUT_PULLUP);
  pinMode(BTN_2, INPUT_PULLUP);
  pinMode(BTN_3, INPUT_PULLUP);

  // Detect if thumbstick is wired up and calibrate center
  calibrateThumbstick();

  tft.reset();
  uint16_t identifier = tft.readID();
  if (identifier == 0x9325 || identifier == 0x9328 || identifier == 0x4535 || 
      identifier == 0x7575 || identifier == 0x9341 || identifier == 0x8357) {
    tft.begin(identifier);
  } else {
    tft.begin(0x9341);
  }

  tft.setRotation(1); // Landscape mode (320x240)
  tft.setTextWrap(false);

  // Landscape Title Screen
  tft.fillScreen(BLUE);
  tft.drawRect(6, 6, 308, 228, WHITE);
  tft.setTextColor(WHITE);
  tft.setTextSize(3);
  tft.setCursor(52, 50);
  tft.println(F("MEMORY BLITZ"));

  tft.setTextSize(2);
  tft.setCursor(45, 105);
  tft.println(F("Pass 3 of 5 Levels"));

  // Shows hardware detection status right on the title screen
  tft.setTextSize(1);
  tft.setTextColor(CYAN);
  tft.setCursor(65, 150);
  if (stickConnected) {
    tft.println(F("Thumbstick: DETECTED (A4/A5)"));
  } else {
    tft.println(F("Thumbstick: UNPLUGGED (Touch Mode)"));
  }

  waitToStartOrRestart();
}

void loop() {
  bool passed = runMinigameRound();
  levelInStage++;

  if (passed) {
    winsInStage++;
    showBanner("LEVEL CLEAR!", "Nice job!", GREEN);
  } else {
    failsInStage++;
    totalErrors++;
    showBanner("MISS!", "Sequence Failed", RED);
  }

  if (failsInStage >= 3 || (stage5Loops > 0 && !passed)) {
    tft.fillScreen(RED);
    tft.setTextColor(WHITE);
    tft.setTextSize(3);
    tft.setCursor(70, 50);
    tft.println(F("GAME OVER!"));
    tft.setTextSize(2);
    tft.setCursor(55, 105);
    tft.print(F("Stage Reached: "));
    tft.println(currentStage);
    tft.setCursor(55, 135);
    tft.print(F("Stage 5 Loops: "));
    tft.println(stage5Loops);
    waitToStartOrRestart();
    return;
  }

  if (winsInStage >= 3) {
    levelInStage = 0;
    winsInStage = 0;
    failsInStage = 0;
    generateStagePool();

    if (currentStage < 5) {
      currentStage++;
      showBanner("STAGE UP!", "Speed Increased!", BLUE);
    } else {
      if (totalErrors == 0) {
        stage5Loops++;
        if (timeLimitMs > 2500) {
          timeLimitMs -= 2500;
        }
        tft.fillScreen(MAGENTA);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(52, 50);
        tft.println(F("FLAWLESS S5!"));
        tft.setTextSize(2);
        tft.setCursor(55, 105);
        tft.println(F("Repeating Stage 5"));
        tft.setCursor(55, 135);
        tft.print(F("New Timer: "));
        tft.print(timeLimitMs / 1000.0, 1);
        tft.println(F("s"));
        delay(2200);
      } else {
        tft.fillScreen(BLUE);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(85, 50);
        tft.println(F("YOU WIN!"));
        tft.setTextSize(2);
        tft.setCursor(55, 105);
        tft.println(F("Stage 5 Complete!"));
        tft.setCursor(55, 135);
        tft.println(F("Go Flawless for OT"));
        waitToStartOrRestart();
      }
    }
  }
}

// Returns the number of columns in the touch grid based on current difficulty stage
uint8_t getTouchGridCols() {
  if (currentStage >= 5) return 4; // Stage 5+: 2x4 grid (8 pads)
  if (currentStage >= 3) return 3; // Stage 3-4: 2x3 grid (6 pads)
  return 2;                        // Stage 1-2: 2x2 grid (4 pads)
}

uint8_t getTouchPadCount() {
  return getTouchGridCols() * 2;
}

// Calculates position and dimensions for each touch pad in a 2x2, 2x3, or 2x4 grid
void getTouchPadBounds(uint8_t index, int &x, int &y, int &w, int &h) {
  uint8_t cols = getTouchGridCols();
  uint8_t row = index / cols;
  uint8_t col = index % cols;

  y = (row == 0) ? 74 : 156;
  h = 70;

  if (cols == 2) {
    w = 110;
    x = 40 + col * 130; // x: 40, 170
  } else if (cols == 3) {
    w = 88;
    x = 14 + col * 102; // x: 14, 116, 218
  } else {
    w = 68;
    x = 11 + col * 76;  // x: 11, 87, 163, 239
  }
}

// Restore shared A2/A3 pins back to OUTPUT and HIGH after reading TouchScreen
void restoreTFTPins() {
  pinMode(XM, OUTPUT);
  pinMode(YP, OUTPUT);
  digitalWrite(XM, HIGH);
  digitalWrite(YP, HIGH);
}

// Read clean analog value from thumbstick (discards first sample to prevent ADC mux ghosting)
int readStickAnalog(uint8_t pin) {
  analogRead(pin);
  return analogRead(pin);
}

// Read digital state of A (D12), B (D11), or X (D10) button
bool isButtonPressed(uint8_t pin) {
  return (digitalRead(pin) == LOW);
}

// Save calibrated thumbstick parameters to EEPROM
void saveStickCalibrationEEPROM() {
  int addr = EEPROM_CAL_MAGIC_ADDR;
  EEPROM.update(addr, EEPROM_CAL_MAGIC_VAL);
  addr += 1;
  EEPROM.put(addr, stickCenterX); addr += sizeof(int);
  EEPROM.put(addr, stickCenterY); addr += sizeof(int);
  for (uint8_t d = 0; d < 4; d++) {
    EEPROM.put(addr, calTargetX[d]); addr += sizeof(int);
    EEPROM.put(addr, calTargetY[d]); addr += sizeof(int);
  }
}

// Load calibrated thumbstick parameters from EEPROM if previously saved
bool loadStickCalibrationEEPROM() {
  if (EEPROM.read(EEPROM_CAL_MAGIC_ADDR) != EEPROM_CAL_MAGIC_VAL) {
    return false;
  }
  int addr = EEPROM_CAL_MAGIC_ADDR + 1;
  EEPROM.get(addr, stickCenterX); addr += sizeof(int);
  EEPROM.get(addr, stickCenterY); addr += sizeof(int);
  for (uint8_t d = 0; d < 4; d++) {
    EEPROM.get(addr, calTargetX[d]); addr += sizeof(int);
    EEPROM.get(addr, calTargetY[d]); addr += sizeof(int);
  }
  return true;
}

// Auto-detect if the slide thumbstick is wired up, and load or calibrate center
void initThumbstick() {
  pinMode(STICK_X, INPUT_PULLUP);
  pinMode(STICK_Y, INPUT_PULLUP);
  delay(5);
  int testX = readStickAnalog(STICK_X);
  int testY = readStickAnalog(STICK_Y);

  pinMode(STICK_X, INPUT);
  pinMode(STICK_Y, INPUT);
  delay(5);

  if (testX > 960 && testY > 960) {
    stickConnected = false; // Pins are floating (unplugged)
  } else {
    stickConnected = true;
  }

  // Load saved directional vectors if available
  bool hadSaved = loadStickCalibrationEEPROM();

  // If stick is physically connected right now, refresh resting center
  if (stickConnected) {
    long sumX = 0, sumY = 0;
    for (uint8_t i = 0; i < 16; i++) {
      sumX += readStickAnalog(STICK_X);
      sumY += readStickAnalog(STICK_Y);
      delay(3);
    }
    int liveCX = sumX / 16;
    int liveCY = sumY / 16;

    if (liveCX >= 250 && liveCX <= 770 && liveCY >= 250 && liveCY <= 770) {
      if (!hadSaved) {
        stickCenterX = liveCX;
        stickCenterY = liveCY;
        // Default directional targets relative to center (with Right/Down matched)
        calTargetX[DIR_UP]    = stickCenterX;
        calTargetY[DIR_UP]    = stickCenterY + 240;
        calTargetX[DIR_DOWN]  = stickCenterX + 240;
        calTargetY[DIR_DOWN]  = stickCenterY;
        calTargetX[DIR_LEFT]  = stickCenterX - 240;
        calTargetY[DIR_LEFT]  = stickCenterY;
        calTargetX[DIR_RIGHT] = stickCenterX;
        calTargetY[DIR_RIGHT] = stickCenterY - 240;
      }
    }
  }
}

// Read touch screen and map coordinates to Landscape (320x240)
bool getLandscapeTouchRaw(int &px, int &py, int &rawX, int &rawY) {
  TSPoint p = ts.getPoint();
  restoreTFTPins();

  if (p.z > MINPRESSURE && p.z < MAXPRESSURE) {
    rawX = p.x;
    rawY = p.y;

    if (INVERT_TOUCH_X) {
      px = map(p.y, TS_MAXY, TS_MINY, 0, 320);
    } else {
      px = map(p.y, TS_MINY, TS_MAXY, 0, 320);
    }

    if (INVERT_TOUCH_Y) {
      py = map(p.x, TS_MAXX, TS_MINX, 0, 240);
    } else {
      py = map(p.x, TS_MINX, TS_MAXX, 0, 240);
    }

    px = constrain(px, 0, 319);
    py = constrain(py, 0, 239);
    return true;
  }
  return false;
}

bool getLandscapeTouch(int &px, int &py) {
  int rx, ry;
  return getLandscapeTouchRaw(px, py, rx, ry);
}

// Check if any active input is currently held down
bool isAnyInputHeld() {
  if (isButtonPressed(BTN_A) || isButtonPressed(BTN_B) || isButtonPressed(BTN_X)) {
    return true;
  }

  if (stickConnected) {
    int dx = abs(readStickAnalog(STICK_X) - stickCenterX);
    int dy = abs(readStickAnalog(STICK_Y) - stickCenterY);
    if (dx > STICK_RELEASE_DIST || dy > STICK_RELEASE_DIST) {
      return true;
    }
  }

  int px, py;
  if (getLandscapeTouch(px, py)) {
    return true;
  }

  return false;
}

void waitForRelease() {
  while (isAnyInputHeld()) {
    delay(15);
  }
}

// Populate and shuffle the 5 levels for the current stage
void generateStagePool() {
  if (debugForceMode != -1) {
    for (uint8_t i = 0; i < 5; i++) {
      stagePool[i] = (uint8_t)debugForceMode;
    }
    return;
  }

  stagePool[0] = GAME_TOUCH;
  stagePool[1] = GAME_STICK;
  stagePool[2] = GAME_BUTTONS;
  stagePool[3] = random(0, 3);
  stagePool[4] = random(0, 3);

  for (uint8_t i = 4; i > 0; i--) {
    uint8_t j = random(0, i + 1);
    uint8_t temp = stagePool[i];
    stagePool[i] = stagePool[j];
    stagePool[j] = temp;
  }
}


// ==========================================
// 1. PIN DEFINITIONS & ORIENTATION SETTINGS
// ==========================================

// TFT Control Pins (Data pins D2-D9 remain wired to Uno D2-D9)
#define LCD_CS    A3 // Shared with Touch YP (must be analog)
#define LCD_CD    A2 // Shared with Touch XM (must be analog)
#define LCD_WR    A1
#define LCD_RD    A0
#define LCD_RESET 13 // Rewired from A4 to Digital Pin 13

// Touchscreen shared pins
#define YP A3
#define XM A2
#define YM 9
#define XP 8

// Touch calibration for Elegoo 2.8" TFT
#define TS_MINX 120
#define TS_MAXX 900
#define TS_MINY 70
#define TS_MAXY 920
#define MINPRESSURE 10
#define MAXPRESSURE 1000

// Landscape Touch Axis Toggles
#define INVERT_TOUCH_X true
#define INVERT_TOUCH_Y true

// 3 Momentary Push Buttons (Wired between pin and GND)
#define BTN_1 10
#define BTN_2 11
#define BTN_3 12

// Slide Thumbstick (Analog inputs on A4 and A5)
#define STICK_X A4
#define STICK_Y A5

#define STICK_TRIGGER_DIST 180 // Distance from center needed to register a slide
#define STICK_RELEASE_DIST 110 // Distance from center considered back at rest

// 16-bit RGB565 Color Definitions
#define BLACK    0x0000
#define BLUE     0x001F
#define RED      0xF800
#define GREEN    0x07E0
#define CYAN     0x07FF
#define MAGENTA  0xF81F
#define YELLOW   0xFFE0
#define WHITE    0xFFFF
#define DARKGREY 0x39E7
#define ORANGE   0xFD20

Elegoo_TFTLCD tft(LCD_CS, LCD_CD, LCD_WR, LCD_RD, LCD_RESET);
TouchScreen ts = TouchScreen(XP, YP, XM, YM, 300);

// ==========================================
// 2. GAME CONSTANTS & STATE VARIABLES
// ==========================================
#define GAME_TOUCH   0
#define GAME_STICK   1
#define GAME_BUTTONS 2

#define DIR_UP    0
#define DIR_DOWN  1
#define DIR_LEFT  2
#define DIR_RIGHT 3

#define MAX_SEQ_LEN 14
uint8_t sequence[MAX_SEQ_LEN];
uint8_t currentSeqLen = 3;

uint8_t currentStage = 1;          // Stages 1 to 5
uint8_t levelInStage = 0;          // Current level index within the 5-level stage (0 to 4)
uint8_t winsInStage = 0;           // Need 3 wins out of the 5 levels to advance
uint8_t failsInStage = 0;          // 3 fails in one stage = Game Over
uint8_t totalErrors = 0;           // Must be 0 to unlock Stage 5 endless overtime loop
uint8_t stage5Loops = 0;           // Count of Stage 5 clears
bool isFirstBoot = true;           // Seeds RNG on first start press

uint8_t stagePool[5];              // Holds the 5 randomized minigame types for the stage
unsigned long timeLimitMs = 20000; // Default 20.0s (20000 ms), cuts 2.5s per Stage 5 win
uint8_t activeGame = GAME_TOUCH;

// Thumbstick calibration & auto-detection state
bool stickConnected = false;
int stickCenterX = 512;
int stickCenterY = 512;

// Secret Debug Mode Variables
// debugForceMode: -1 = All (Normal), 0 = Touch Only, 1 = Stick Only, 2 = Buttons Only
int8_t debugForceMode = -1;
// debugCheatLevel: 0 = Off, 1 = Show HUD Sequence Hints, 2 = God Mode (No Fail + Hints)
uint8_t debugCheatLevel = 0;
// debugStartStage: 1 to 5 = Stage 1-5, 6 = Stage 5 Overtime Loop 1
uint8_t debugStartStage = 1;

// ==========================================
// 3. HARDWARE & TOUCH HELPERS
// ==========================================

// Restore shared A2/A3 pins back to OUTPUT and HIGH after reading TouchScreen
void restoreTFTPins() {
  pinMode(XM, OUTPUT);
  pinMode(YP, OUTPUT);
  digitalWrite(XM, HIGH);
  digitalWrite(YP, HIGH);
}

// Read clean analog value (discards first sample to prevent ADC mux ghosting from A2/A3)
int readCleanAnalog(uint8_t pin) {
  analogRead(pin);
  return analogRead(pin);
}

// Auto-detect if the slide thumbstick is wired up, and calibrate its resting center
void calibrateThumbstick() {
  pinMode(STICK_X, INPUT_PULLUP);
  pinMode(STICK_Y, INPUT_PULLUP);
  delay(5);
  int testX = readCleanAnalog(STICK_X);
  int testY = readCleanAnalog(STICK_Y);

  pinMode(STICK_X, INPUT);
  pinMode(STICK_Y, INPUT);
  delay(5);

  if (testX > 960 && testY > 960) {
    stickConnected = false; // Pins are floating (unplugged)
    return;
  }

  stickConnected = true;
  long sumX = 0;
  long sumY = 0;
  for (uint8_t i = 0; i < 16; i++) {
    sumX += readCleanAnalog(STICK_X);
    sumY += readCleanAnalog(STICK_Y);
    delay(3);
  }
  stickCenterX = sumX / 16;
  stickCenterY = sumY / 16;

  if (stickCenterX < 300 || stickCenterX > 720) stickCenterX = 512;
  if (stickCenterY < 300 || stickCenterY > 720) stickCenterY = 512;
}

// Read touch screen and map coordinates to Landscape (320x240)
bool getLandscapeTouchRaw(int &px, int &py, int &rawX, int &rawY) {
  TSPoint p = ts.getPoint();
  restoreTFTPins();

  if (p.z > MINPRESSURE && p.z < MAXPRESSURE) {
    rawX = p.x;
    rawY = p.y;

    if (INVERT_TOUCH_X) {
      px = map(p.y, TS_MAXY, TS_MINY, 0, 320);
    } else {
      px = map(p.y, TS_MINY, TS_MAXY, 0, 320);
    }

    if (INVERT_TOUCH_Y) {
      py = map(p.x, TS_MAXX, TS_MINX, 0, 240);
    } else {
      py = map(p.x, TS_MINX, TS_MAXX, 0, 240);
    }

    px = constrain(px, 0, 319);
    py = constrain(py, 0, 239);
    return true;
  }
  return false;
}

bool getLandscapeTouch(int &px, int &py) {
  int rx, ry;
  return getLandscapeTouchRaw(px, py, rx, ry);
}

// Check if any active input is currently held down
bool isAnyInputHeld() {
  if (digitalRead(BTN_1) == LOW || digitalRead(BTN_2) == LOW || digitalRead(BTN_3) == LOW) {
    return true;
  }

  if (stickConnected) {
    int dx = abs(readCleanAnalog(STICK_X) - stickCenterX);
    int dy = abs(readCleanAnalog(STICK_Y) - stickCenterY);
    if (dx > STICK_RELEASE_DIST || dy > STICK_RELEASE_DIST) {
      return true;
    }
  }

  int px, py;
  if (getLandscapeTouch(px, py)) {
    return true;
  }

  return false;
}

// Wait until buttons are unpressed, thumbstick is centered, and screen is untouched
void waitForRelease() {
  while (isAnyInputHeld()) {
    delay(15);
  }
}

// Populate and shuffle the 5 levels for the current stage
void generateStagePool() {
  if (debugForceMode != -1) {
    for (uint8_t i = 0; i < 5; i++) {
      stagePool[i] = (uint8_t)debugForceMode;
    }
    return;
  }

  stagePool[0] = GAME_TOUCH;
  stagePool[1] = GAME_STICK;
  stagePool[2] = GAME_BUTTONS;
  stagePool[3] = random(0, 3);
  stagePool[4] = random(0, 3);

  for (uint8_t i = 4; i > 0; i--) {
    uint8_t j = random(0, i + 1);
    uint8_t temp = stagePool[i];
    stagePool[i] = stagePool[j];
    stagePool[j] = temp;
  }
}


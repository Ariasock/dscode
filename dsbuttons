// 7. ROUND & STAGE MANAGEMENT
// ==========================================

bool runMinigameRound() {
  activeGame = stagePool[levelInStage];

  drawHUD();
  if (activeGame == GAME_TOUCH)   drawTouchBoard();
  if (activeGame == GAME_STICK)   drawStickBoard();
  if (activeGame == GAME_BUTTONS) drawButtonBoard();

  playSequence();
  waitForRelease();

  unsigned long startTime = millis();
  int lastBarWidth = 300;
  uint16_t lastBarColor = GREEN;
  uint8_t stepIndex = 0;

  drawDebugHint(stepIndex);

  while (stepIndex < currentSeqLen) {
    unsigned long elapsed = millis() - startTime;
    if (elapsed >= timeLimitMs) {
      if (debugCheatLevel == 2) return true; // God mode never fails on timeout
      return false; // Timed out
    }

    updateTimerBar(elapsed, timeLimitMs, lastBarWidth, lastBarColor);

    int8_t userChoice = pollActiveInput();
    if (userChoice != -1) {
      unsigned long flashStart = millis();
      highlightStep(userChoice, true);
      delay(140);
      highlightStep(userChoice, false);
      startTime += (millis() - flashStart);

      if (userChoice != sequence[stepIndex] && debugCheatLevel < 2) {
        waitForRelease();
        return false;
      }

      stepIndex++;
      if (stepIndex < currentSeqLen) {
        drawDebugHint(stepIndex);
        while (isAnyInputHeld()) {
          unsigned long heldElapsed = millis() - startTime;
          if (heldElapsed >= timeLimitMs) {
            if (debugCheatLevel == 2) return true;
            return false;
          }
          updateTimerBar(heldElapsed, timeLimitMs, lastBarWidth, lastBarColor);
          delay(10);
        }
      } else {
        waitForRelease();
      }
    }
  }

  return true;
}


void runStickCalibrationWizard() {
  tft.fillScreen(BLACK);
  tft.fillRect(0, 0, 275, 26, CYAN);
  tft.setTextColor(BLACK);
  tft.setTextSize(2);
  tft.setCursor(8, 5);
  tft.print(F("STICK CALIBRATION"));

  // Cancel button in top-right corner in case thumbstick isn't wired
  tft.fillRect(278, 0, 42, 26, RED);
  tft.drawRect(278, 0, 42, 26, WHITE);
  tft.setTextColor(WHITE);
  tft.setCursor(286, 5);
  tft.print(F("[X]"));

  waitForRelease();

  // --- STEP 1: RECORD CENTER ---
  tft.setTextColor(YELLOW);
  tft.setTextSize(2);
  tft.setCursor(20, 40);
  tft.print(F("1/5: HANDS OFF STICK"));
  tft.setTextColor(WHITE);
  tft.setTextSize(1);
  tft.setCursor(20, 64);
  tft.print(F("Measuring resting center position..."));

  long sumCX = 0, sumCY = 0;
  for (uint8_t i = 0; i < 24; i++) {
    int px, py;
    if (getLandscapeTouch(px, py) && px >= 270 && py <= 35) return; // Cancelled
    sumCX += readStickAnalog(STICK_X);
    sumCY += readStickAnalog(STICK_Y);
    tft.fillRect(40, 82, i * 10, 8, GREEN);
    delay(25);
  }
  stickCenterX = sumCX / 24;
  stickCenterY = sumCY / 24;

  // --- STEPS 2 TO 5: RECORD UP, DOWN, LEFT, RIGHT ---
  const char* stepTitles[4] = {
    "2/5: PUSH & HOLD UP",
    "3/5: PUSH & HOLD DOWN",
    "4/5: PUSH & HOLD LEFT",
    "5/5: PUSH & HOLD RIGHT"
  };

  for (uint8_t d = 0; d < 4; d++) {
    tft.fillRect(0, 30, 320, 210, BLACK);

    tft.fillCircle(160, 152, 12, DARKGREY);
    for (uint8_t a = 0; a < 4; a++) {
      drawStickArrow(a, (a == d));
    }

    tft.setTextColor(YELLOW);
    tft.setTextSize(2);
    tft.setCursor(16, 34);
    tft.print(stepTitles[d]);

    while (true) {
      int px, py;
      if (getLandscapeTouch(px, py) && px >= 270 && py <= 35) return; // Cancelled

      int sx = readStickAnalog(STICK_X);
      int sy = readStickAnalog(STICK_Y);
      int dx = sx - stickCenterX;
      int dy = sy - stickCenterY;

      tft.fillRect(0, 54, 270, 14, BLACK);
      tft.setTextColor(CYAN);
      tft.setTextSize(1);
      tft.setCursor(16, 56);
      tft.print(F("Live X:"));
      tft.print(sx);
      tft.print(F(" Y:"));
      tft.print(sy);
      tft.print(F(" (dX:"));
      tft.print(dx);
      tft.print(F(" dY:"));
      tft.print(dy);
      tft.print(F(")"));

      if (abs(dx) >= STICK_MIN_MOVE || abs(dy) >= STICK_MIN_MOVE) {
        long accX = 0, accY = 0;
        bool heldSteady = true;
        for (uint8_t s = 0; s < 16; s++) {
          int rx = readStickAnalog(STICK_X);
          int ry = readStickAnalog(STICK_Y);
          if (abs(rx - stickCenterX) < (STICK_MIN_MOVE - 20) &&
              abs(ry - stickCenterY) < (STICK_MIN_MOVE - 20)) {
            heldSteady = false;
            break;
          }
          accX += rx;
          accY += ry;
          delay(15);
        }

        if (heldSteady) {
          calTargetX[d] = accX / 16;
          calTargetY[d] = accY / 16;
          break;
        }
      }
      delay(25);
    }

    tft.fillRect(0, 32, 275, 36, BLACK);
    tft.setTextColor(GREEN);
    tft.setTextSize(2);
    tft.setCursor(16, 34);
    tft.print(F("CAPTURED! ("));
    tft.print(calTargetX[d]);
    tft.print(F(","));
    tft.print(calTargetY[d]);
    tft.print(F(")"));

    tft.setTextColor(WHITE);
    tft.setTextSize(1);
    tft.setCursor(16, 56);
    tft.print(F("Release thumbstick back to center..."));

    while (true) {
      int px, py;
      if (getLandscapeTouch(px, py) && px >= 270 && py <= 35) return;

      int sx = readStickAnalog(STICK_X);
      int sy = readStickAnalog(STICK_Y);
      if (abs(sx - stickCenterX) < STICK_RELEASE_DIST &&
          abs(sy - stickCenterY) < STICK_RELEASE_DIST) {
        break;
      }
      delay(20);
    }
    delay(200);
  }

  stickConnected = true;
  saveStickCalibrationEEPROM();

  tft.fillScreen(GREEN);
  tft.setTextColor(BLACK);
  tft.setTextSize(3);
  tft.setCursor(30, 85);
  tft.print(F("CALIBRATED!"));
  tft.setTextSize(2);
  tft.setCursor(35, 135);
  tft.print(F("Saved to Memory"));
  delay(1200);
}


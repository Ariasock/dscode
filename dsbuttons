  tft.drawRect(85, 200, 150, 26, WHITE);
  tft.setTextColor(WHITE);
  tft.setTextSize(1);
  tft.setCursor(112, 209);
  tft.print(F("[ DEBUG MENU ]"));

  bool openDebug = false;
  waitForRelease();

  while (true) {
    if (isButtonPressed(BTN_A)) break;

    if (isButtonPressed(BTN_B) || isButtonPressed(BTN_X)) {
      openDebug = true;
      break;
    }

    int px, py;
    if (getLandscapeTouch(px, py)) {
      // Check if tap landed inside the [ DEBUG MENU ] button (with a slight padding margin)
      if (px >= 80 && px <= 240 && py >= 195 && py <= 232) {
        openDebug = true;
      }
      break;
    }
    delay(20);
  }

  if (isFirstBoot) {
    randomSeed(micros());
    isFirstBoot = false;
  }

  waitForRelease();
  if (openDebug) {
    runDebugMenu();
  }
  resetGame();
}

// ==========================================
// 8. SETUP & LOOP
// ==========================================

void setup() {
  pinMode(BTN_A, INPUT_PULLUP);
  pinMode(BTN_B, INPUT_PULLUP);
  pinMode(BTN_X, INPUT_PULLUP);

  // Detect thumbstick and load saved EEPROM calibration if present
  initThumbstick();

  tft.reset();
  uint16_t identifier = tft.readID();
  if (identifier == 0x9325 || identifier == 0x9328 || identifier == 0x4535 || 
      identifier == 0x7575 || identifier == 0x9341 || identifier == 0x8357) {
    tft.begin(identifier);
  } else {
    tft.begin(0x9341);
  }

  tft.setRotation(1); // Landscape mode (320x240)
  tft.setTextWrap(false);

  showTitleScreen();
  waitToStartOrRestart();
}

void loop() {
  bool passed = runMinigameRound();
  levelInStage++;

  if (passed) {
    winsInStage++;
    showBanner("LEVEL CLEAR!", "Nice job!", GREEN);
  } else {
    failsInStage++;
    totalErrors++;
    showBanner("MISS!", "Sequence Failed", RED);
  }

  if (failsInStage >= 3 || (stage5Loops > 0 && !passed)) {
    tft.fillScreen(RED);
    tft.setTextColor(WHITE);
    tft.setTextSize(3);
    tft.setCursor(70, 50);
    tft.println(F("GAME OVER!"));
    tft.setTextSize(2);
    tft.setCursor(55, 105);
    tft.print(F("Stage Reached: "));
    tft.println(currentStage);
    tft.setCursor(55, 135);
    tft.print(F("Stage 5 Loops: "));
    tft.println(stage5Loops);
    waitToStartOrRestart();
    return;
  }

  if (winsInStage >= 3) {
    levelInStage = 0;
    winsInStage = 0;
    failsInStage = 0;
    generateStagePool();

    if (currentStage < 5) {
      currentStage++;
      showBanner("STAGE UP!", "Speed Increased!", BLUE);
    } else {
      if (totalErrors == 0) {
        stage5Loops++;
        if (timeLimitMs > 2500) {
          timeLimitMs -= 2500;
        }
        tft.fillScreen(MAGENTA);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(52, 50);
        tft.println(F("FLAWLESS S5!"));
        tft.setTextSize(2);
        tft.setCursor(55, 105);
        tft.println(F("Repeating Stage 5"));
        tft.setCursor(55, 135);
        tft.print(F("New Timer: "));
        tft.print(timeLimitMs / 1000.0, 1);
        tft.println(F("s"));
        delay(2200);
      } else {
        tft.fillScreen(BLUE);
        tft.setTextColor(WHITE);
        tft.setTextSize(3);
        tft.setCursor(85, 50);
        tft.println(F("YOU WIN!"));
        tft.setTextSize(2);
        tft.setCursor(55, 105);
        tft.println(F("Stage 5 Complete!"));
        tft.setCursor(55, 135);
        tft.println(F("Go Flawless for OT"));
        waitToStartOrRestart();
      }
    }
  }
}

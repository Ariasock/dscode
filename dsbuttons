    tft.print(rChar);
    tft.print(cNum);
  } else {
    const char btnNames[3] = {'A', 'B', 'X'};
    tft.print(F("BTN: "));
    tft.print(btnNames[target]);
  }
}

void updateTimerBar(unsigned long elapsed, unsigned long limit, int &lastWidth, uint16_t &lastColor) {
  if (elapsed > limit) elapsed = limit;
  int newWidth = map(limit - elapsed, 0, limit, 0, 300);

  if (newWidth != lastWidth) {
    uint16_t barColor = GREEN;
    if (newWidth < 150) barColor = YELLOW;
    if (newWidth < 75)  barColor = RED;

    if (newWidth < lastWidth) {
      tft.fillRect(10 + newWidth, 28, lastWidth - newWidth, 8, DARKGREY);
    }

    if (barColor != lastColor && newWidth > 0) {
      tft.fillRect(10, 28, newWidth, 8, barColor);
      lastColor = barColor;
    }

    lastWidth = newWidth;
  }
}

// --- MINIGAME 1: TOUCH SCREEN (2x2 at Stg 1-2, 2x3 at Stg 3-4, 2x4 at Stg 5) ---
void drawTouchPad(uint8_t index, bool lit) {
  int x, y, w, h;
  getTouchPadBounds(index, x, y, w, h);

  uint16_t baseColors[8] = {RED, BLUE, GREEN, YELLOW, MAGENTA, CYAN, ORANGE, PURPLE};
  uint16_t drawColor = lit ? WHITE : baseColors[index % 8];

  tft.fillRect(x, y, w, h, drawColor);
  tft.drawRect(x, y, w, h, WHITE);
  if (lit) {
    tft.fillRect(x + 10, y + 10, w - 20, h - 20, baseColors[index % 8]);
  }
}

